{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portfolio.local/schemas/intake.schema.json",
  "title": "Automation Project Intake",
  "type": "object",
  "additionalProperties": false,
  "required": ["companyName", "processDescription", "goals", "idempotencyKey"],
  "properties": {
    "companyName": { "type": "string", "minLength": 2, "maxLength": 120 },
    "contactName": { "type": "string", "maxLength": 120 },
    "contactEmail": { "type": "string", "format": "email", "maxLength": 254 },
    "processDescription": { "type": "string", "minLength": 40, "maxLength": 5000 },
    "currentTools": {
      "type": "array",
      "maxItems": 30,
      "items": { "type": "string", "minLength": 1, "maxLength": 80 },
      "uniqueItems": true
    },
    "goals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": { "type": "string", "minLength": 3, "maxLength": 240 }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "budgetEur": { "type": "number", "minimum": 0, "maximum": 1000000 },
        "deadline": { "type": "string", "format": "date" },
        "dataSensitivity": {
          "type": "string",
          "enum": ["public", "internal", "personal", "special-category", "unknown"]
        },
        "requiresHumanApproval": { "type": "boolean" }
      }
    },
    "idempotencyKey": { "type": "string", "minLength": 8, "maxLength": 120 }
  }
}
